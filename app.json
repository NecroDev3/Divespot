{
  "expo": {
    "name": "DiveSpot",
    "slug": "DiveSpot",
    "version": "1.0.0",
    "description": "Discover, document, and share your diving adventures. Connect with divers worldwide, find the best dive spots, and log your underwater experiences.",
    "orientation": "portrait",
    "icon": "./assets/images/DSLogo.png",
    "scheme": "divespot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#003366",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divespot.necrodev3",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.divespot.necrodev3"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/DSLogo.png",
        "backgroundColor": "#003366"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.divespot.necrodev3"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/DSLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/DSLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#003366"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.147832202304-41re98jvn5ltb30uhh1hvj5upu11180n"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fac2b55e-26d9-414c-aa29-d324c116e6ac"
      }
    }
  }
}
